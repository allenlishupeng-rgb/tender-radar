# Copy to radar.env (never commit radar.env).
RADAR_TEAM_PASSWORD=change-me-to-a-long-random-passphrase
# Your domain for automatic HTTPS, e.g. radar.example.com
RADAR_DOMAIN=
TZ=Asia/Shanghai
